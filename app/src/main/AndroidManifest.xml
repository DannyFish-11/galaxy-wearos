<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Audio / Voice -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Wake lock for background connection -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 这里原先还声明了 BLUETOOTH_SCAN/CONNECT/ADVERTISE、NEARBY_WIFI_DEVICES、
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS：全仓没有任何代码用蓝牙、附近 Wi-Fi 设备，
         也没有任何地方去请求忽略电池优化。声明了没用的权限只会让安装时多几条吓人的授权、
         让上架审核多问几句。需要时再加，而且加的同时要有用它的代码。 -->

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 常驻服务在 Android 14+ 用 specialUse:dataSync 在 Android 15 起每 24 小时只许跑 6 小时
         (到点不停服务就崩),且不许从 BOOT_COMPLETED 启动。见 GalaxyWearService.startForeground。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 通话期间的麦克风型前台服务。Android 14 起后台访问麦克风必须有这一条,
         否则表现是「抬手看表能说话,手一放下 AI 就听不见了」,而且不报任何错。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- ROUND-2-FIX: Android 13+ (API 33, targetSdk=35 强制) 通知运行时权限。
         缺省时所有通知被系统静默丢弃 —— 决策通知(HITL)永远不可见,
         前台服务常驻通知也被隐藏。仅在清单声明后才能在运行时用
         ActivityResultContracts.RequestPermission 请求(见 MainActivity)。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- H3: Auto-restart on boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 可打扰性传感(com.galaxy.wear.sensing):手表本地判断"现在能不能打扰他"。
         W7-FIX 当初把三个传感权限一起删掉,理由是"功能没实现、别在安装时吓用户"。
         现在心率这一路真的用上了(InterruptibilityMonitor 采 Sensor.TYPE_HEART_RATE),
         所以**只**加回 BODY_SENSORS 这一个:
           - 加速度计不需要权限;
           - 抬腕靠亮屏代理(Wear OS 抬腕亮屏),不需要权限;
           - 勿扰状态是只读查询,不需要权限;
           - ACTIVITY_RECOGNITION 只有计步/活动识别才需要,本实现没用 —— 不加回,
             免得重蹈"声明了却没人用"的覆辙。
         BODY_SENSORS_BACKGROUND 同样不加:采集只发生在常驻前台服务(dataSync)里,
         按系统定义属于前台访问。
         没授权也不会瘫:心率那一路自动退出加权,confidence 相应下降。 -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!-- Wear OS hardware -->
    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:name=".GalaxyWearApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:ignore="WearSplashScreen">

        <!-- Wear OS: declares this app as a standalone watch app (works without phone companion) -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Main launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 通话前台服务与常驻连接服务 -->
        <!-- 通话期间才起,挂断即停。不把 microphone 类型并进常驻的 GalaxyWearService:
             那等于表上常年挂着一个录音指示灯。 -->
        <service
            android:name=".call.VoiceCallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".service.GalaxyWearService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse"
            android:stopWithTask="false">
            <!-- specialUse 必须声明用途。这个服务做的事:保持一条到用户自己网关的长连接,接收智能体的
                 提问与消息、回传用户的回答。不属于系统预设的任何一类前台服务。 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="persistent_connection_to_user_gateway" />
        </service>

        <!-- BroadcastReceiver for boot and package replacement events.
             Android 8+ forbids Services from receiving BOOT_COMPLETED directly.
             The receiver delegates to GalaxyWearService.
             SECURITY: android:exported="false" because BOOT_COMPLETED and
             MY_PACKAGE_REPLACED are system-only protected broadcasts. Only the
             Android system can send these actions; no third-party app can trigger
             them, so exported=false is safe and correct (prevents malicious
             explicit intents from starting our service). -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Tile service (glanceable status) -->
        <service
            android:name=".tile.GalaxyTileService"
            android:exported="true"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- HUMAN-DECISION: WearOS 决策回复接收器。
             处理用户在决策通知上的选项选择和语音输入，
             通过 ReplyReceiver 将人类回复转发到 AIPClient。
             SECURITY: exported="false" 仅内部使用，不暴露给外部应用。 -->
        <receiver
            android:name=".receiver.ReplyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.galaxy.wear.ACTION_DECISION_REPLY" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
